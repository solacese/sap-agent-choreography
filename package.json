{
  "name": "sap-agent-choreography",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.backend.json --pretty false",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test:run && npm run build",
    "build:backend": "npx esbuild backend/api.ts backend/worker.ts backend/aggregator.ts --bundle --platform=node --target=node22 --outdir=.aws-sam/build",
    "deploy:cloud": "bash scripts/deploy-cloud.sh",
    "destroy:cloud": "aws cloudformation delete-stack --stack-name sap-agent-choreography-demo --region ${AWS_REGION:-ca-central-1}",
    "configure:solace": "node scripts/configure-solace.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1145.0",
    "@aws-sdk/client-lambda": "^3.1145.0",
    "@aws-sdk/client-secrets-manager": "^3.1145.0",
    "@aws-sdk/lib-dynamodb": "^3.1145.0",
    "lucide-react": "^0.548.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^26.6.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
